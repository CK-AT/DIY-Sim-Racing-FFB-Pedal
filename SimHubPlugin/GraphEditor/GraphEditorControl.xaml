<UserControl x:Class="User.PluginSdkDemo.GraphEditor.GraphEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:User.PluginSdkDemo.GraphEditor"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             KeyDown="GraphEditorControl_KeyDown"
             d:DesignHeight="400" d:DesignWidth="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:SignalGroupOptionsConverter x:Key="SignalGroupOptionsConverter" />
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <DataTemplate x:Key="PortEntryTemplate">
            <DockPanel Margin="0,2,0,2">
                <TextBlock Text="{Binding KindLabel}" Foreground="#CCCCCC" FontSize="10" Width="54" />
                <StackPanel Orientation="Horizontal">
                    <TextBox
                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                             Background="#1E1E1E"
                             Foreground="White"
                             BorderBrush="#4A4A4A"
                             BorderThickness="1"
                             Padding="2,1,2,1"
                             ContextMenu="{x:Null}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseSignalOptions}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseSignalOptions}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ComboBox x:Name="SignalPickerCombo"
                                  IsTextSearchEnabled="True"
                                  IsEditable="True"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  BorderBrush="#4A4A4A"
                                  BorderThickness="1"
                                  Padding="2,0,2,0"
                                  StaysOpenOnEdit="True"
                                  ItemsSource="{Binding SignalOptions}"
                                  Text="{Binding Name, UpdateSourceTrigger=LostFocus}">
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PART_EditableTextBox"
                                                 Grid.Column="0"
                                                 Background="#1E1E1E"
                                                 Foreground="White"
                                                 BorderThickness="0"
                                                 Padding="2,1,2,1"
                                                 ContextMenu="{x:Null}"
                                                 Text="{TemplateBinding Text}" />
                                        <ToggleButton Grid.Column="1"
                                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Background="#1E1E1E"
                                                      BorderBrush="#4A4A4A"
                                                      BorderThickness="1"
                                                      Focusable="False">
                                            <TextBlock Text="▾" Foreground="White" HorizontalAlignment="Center" />
                                        </ToggleButton>
                                        <Popup Placement="Bottom"
                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                               AllowsTransparency="True"
                                               PopupAnimation="None"
                                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                            <Border Background="#1E1E1E" BorderBrush="#4A4A4A" BorderThickness="1">
                                                <ScrollViewer MaxHeight="240">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </ComboBox.Template>
                        </ComboBox>
                    </Grid>
                    <Button Content="Settings..."
                            Margin="6,0,0,0"
                            Height="22"
                            Background="#1E1E1E"
                            Foreground="White"
                            BorderBrush="#4A4A4A"
                            BorderThickness="1"
                            Padding="4,1,4,1"
                            Click="EditParamUi_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ShowParamFields}" Value="True" />
                                            <Condition Binding="{Binding HideParamUiButton}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="×"
                            Margin="6,0,0,0"
                            Width="22"
                            Height="22"
                            Background="#1E1E1E"
                            Foreground="#CC6666"
                            BorderBrush="#4A4A4A"
                            BorderThickness="1"
                            Padding="0"
                            FontSize="14"
                            ToolTip="Remove port"
                            Visibility="{Binding AllowRemove, Converter={StaticResource BoolToVisibility}}"
                            Click="ButtonRemovePort_Click" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="InspectorConstTemplate">
            <StackPanel>
                <TextBlock Text="Title" Foreground="#BBBBBB" FontSize="10" />
                <TextBox Margin="0,2,0,6"
                         Background="#1E1E1E"
                         Foreground="White"
                         BorderBrush="#4A4A4A"
                         BorderThickness="1"
                         Padding="3,2,3,2"
                         Text="{Binding Title, Mode=OneWay}"
                         TextChanged="InspectorTitle_TextChanged" />
                <TextBlock Text="Const Value" Foreground="#BBBBBB" FontSize="10" />
                <TextBox Margin="0,2,0,6"
                         Background="#1E1E1E"
                         Foreground="White"
                         BorderBrush="#4A4A4A"
                         BorderThickness="1"
                         Padding="3,2,3,2"
                         Text="{Binding ConstValue, Mode=OneWay}"
                         TextChanged="InspectorConst_TextChanged" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="InspectorOpTemplate">
            <StackPanel>
                <TextBlock Text="Title" Foreground="#BBBBBB" FontSize="10" />
                <TextBox Margin="0,2,0,6"
                         Background="#1E1E1E"
                         Foreground="White"
                         BorderBrush="#4A4A4A"
                         BorderThickness="1"
                         Padding="3,2,3,2"
                         Text="{Binding Title, Mode=OneWay}"
                         TextChanged="InspectorTitle_TextChanged" />
                <TextBlock Text="Operation" Foreground="#BBBBBB" FontSize="10" />
                <ComboBox Margin="0,2,0,6"
                          Background="#1E1E1E"
                          Foreground="White"
                          BorderBrush="#4A4A4A"
                          BorderThickness="1"
                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=OpChoices}"
                          SelectedItem="{Binding Op, Mode=OneWay}"
                          SelectionChanged="InspectorOp_SelectionChanged" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="InspectorFuncTemplate">
            <StackPanel>
                <TextBlock Text="Title" Foreground="#BBBBBB" FontSize="10" />
                <TextBox Margin="0,2,0,6"
                         Background="#1E1E1E"
                         Foreground="White"
                         BorderBrush="#4A4A4A"
                         BorderThickness="1"
                         Padding="3,2,3,2"
                         Text="{Binding Title, Mode=OneWay}"
                         TextChanged="InspectorTitle_TextChanged" />
                <TextBlock Text="Function" Foreground="#BBBBBB" FontSize="10" />
                <ComboBox Margin="0,2,0,6"
                          Background="#1E1E1E"
                          Foreground="White"
                          BorderBrush="#4A4A4A"
                          BorderThickness="1"
                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FuncChoices}"
                          SelectedItem="{Binding Func, Mode=OneWay}"
                          SelectionChanged="InspectorFunc_SelectionChanged" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="InspectorInputTemplate">
            <StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsLibraryGraph}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Signal Group" Foreground="#BBBBBB" FontSize="10" />
                    <ComboBox Margin="0,2,0,6"
                              Background="#1E1E1E"
                              Foreground="White"
                              BorderBrush="#4A4A4A"
                              BorderThickness="1"
                              ItemsSource="{Binding Kind, Converter={StaticResource SignalGroupOptionsConverter}}"
                              SelectedItem="{Binding SignalGroup, Mode=OneWay}"
                              Loaded="InspectorSignalGroup_Loaded"
                              SelectionChanged="InspectorSignalGroup_SelectionChanged" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsLibraryGraph}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Title" Foreground="#BBBBBB" FontSize="10" />
                    <TextBox Margin="0,2,0,6"
                             Background="#1E1E1E"
                             Foreground="White"
                             BorderBrush="#4A4A4A"
                             BorderThickness="1"
                             Padding="3,2,3,2"
                             Text="{Binding Title, Mode=OneWay}"
                             TextChanged="InspectorTitle_TextChanged" />
                </StackPanel>
                <TextBlock Text="Ports" Foreground="#BBBBBB" Margin="0,6,0,2" FontSize="10" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="ButtonAddOutputPortTemplate"
                            Content="Add Port"
                            Background="#1E1E1E"
                            Foreground="White"
                            BorderBrush="#4A4A4A"
                            BorderThickness="1"
                            Padding="2,2,2,2"
                            Click="ButtonAddOutputPort_Click" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=PortEntries}"
                              ItemTemplate="{StaticResource PortEntryTemplate}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="InspectorOutputTemplate">
            <StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsLibraryGraph}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Signal Group" Foreground="#BBBBBB" FontSize="10" />
                    <ComboBox Margin="0,2,0,6"
                              Background="#1E1E1E"
                              Foreground="White"
                              BorderBrush="#4A4A4A"
                              BorderThickness="1"
                              ItemsSource="{Binding Kind, Converter={StaticResource SignalGroupOptionsConverter}}"
                              SelectedItem="{Binding SignalGroup, Mode=OneWay}"
                              Loaded="InspectorSignalGroup_Loaded"
                              SelectionChanged="InspectorSignalGroup_SelectionChanged" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsLibraryGraph}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Title" Foreground="#BBBBBB" FontSize="10" />
                    <TextBox Margin="0,2,0,6"
                             Background="#1E1E1E"
                             Foreground="White"
                             BorderBrush="#4A4A4A"
                             BorderThickness="1"
                             Padding="3,2,3,2"
                             Text="{Binding Title, Mode=OneWay}"
                             TextChanged="InspectorTitle_TextChanged" />
                </StackPanel>
                <TextBlock Text="Ports" Foreground="#BBBBBB" Margin="0,6,0,2" FontSize="10" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="ButtonAddInputPortTemplate"
                            Content="Add Port"
                            Background="#1E1E1E"
                            Foreground="White"
                            BorderBrush="#4A4A4A"
                            BorderThickness="1"
                            Padding="2,2,2,2"
                            Click="ButtonAddInputPort_Click" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=PortEntries}"
                              ItemTemplate="{StaticResource PortEntryTemplate}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="InspectorParamTemplate">
            <StackPanel>
                <TextBlock Text="Signal Group" Foreground="#BBBBBB" FontSize="10" />
                <ComboBox Margin="0,2,0,6"
                          Background="#1E1E1E"
                          Foreground="White"
                          BorderBrush="#4A4A4A"
                          BorderThickness="1"
                          ItemsSource="{Binding Kind, Converter={StaticResource SignalGroupOptionsConverter}}"
                          SelectedItem="{Binding SignalGroup, Mode=OneWay}"
                          Loaded="InspectorSignalGroup_Loaded"
                          SelectionChanged="InspectorSignalGroup_SelectionChanged" />
                <TextBlock Text="Ports" Foreground="#BBBBBB" Margin="0,6,0,2" FontSize="10" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="ButtonAddParamPortTemplate"
                            Content="Add Port"
                            Background="#1E1E1E"
                            Foreground="White"
                            BorderBrush="#4A4A4A"
                            BorderThickness="1"
                            Padding="2,2,2,2"
                            Click="ButtonAddOutputPort_Click" />
                </StackPanel>
                <ListBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=PortEntries}"
                         ItemTemplate="{StaticResource PortEntryTemplate}"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectedItem="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry, Mode=TwoWay}" />
                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="Selected Port" Foreground="#BBBBBB" Margin="0,6,0,2" FontSize="10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Foreground="#888888" FontSize="9" />
                        <TextBlock Grid.Column="1" Text="Value" Foreground="#888888" FontSize="9" />
                    </Grid>
                    <Expander Header="Range" IsExpanded="True" Margin="0,6,0,0">
                        <StackPanel Margin="0,4,0,0">
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Default" Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="3,2,3,2"
                                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry.ParamDefault, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Min" Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="3,2,3,2"
                                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry.ParamMin, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Max" Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="3,2,3,2"
                                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry.ParamMax, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <Expander Header="UI" IsExpanded="True" Margin="0,6,0,0">
                        <StackPanel Margin="0,4,0,0">
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Widget" Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          Background="#1E1E1E"
                                          Foreground="White"
                                          BorderBrush="#4A4A4A"
                                          BorderThickness="1"
                                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ParamWidgetChoices}"
                                          SelectedItem="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry.UiWidget, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Label" Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="3,2,3,2"
                                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry.UiLabel, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Group" Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="3,2,3,2"
                                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry.UiGroup, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Units" Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="3,2,3,2"
                                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry.UiUnits, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Step" Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="3,2,3,2"
                                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry.UiStep, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Precision" Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="3,2,3,2"
                                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry.UiPrecision, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Log Scale" Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1"
                                          Foreground="#CCCCCC"
                                          FontSize="10"
                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry.UiLogScale, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Options" Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Top" />
                                <TextBox Grid.Column="1"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="3,2,3,2"
                                         AcceptsReturn="True"
                                         MinHeight="60"
                                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedPortEntry.UiOptionsText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="InspectorIncludeTemplate">
            <StackPanel>
                <TextBlock Text="Include Path" Foreground="#BBBBBB" FontSize="10" />
                <DockPanel Margin="0,2,0,6">
                    <Button Content="..."
                            Width="28"
                            Height="22"
                            Margin="0,0,6,0"
                            Tag="{Binding ElementName=EditIncludePathTemplate}"
                            Click="ButtonBrowseInclude_Click" />
                    <TextBox x:Name="EditIncludePathTemplate"
                             Background="#1E1E1E"
                             Foreground="White"
                             BorderBrush="#4A4A4A"
                             BorderThickness="1"
                             Padding="3,2,3,2"
                             Text="{Binding IncludePath, Mode=OneWay}"
                             TextChanged="EditIncludePath_TextChanged" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Open"
                            Width="70"
                            Height="22"
                            Margin="0,0,6,0"
                            Click="ButtonOpenInclude_Click" />
                    <Button Content="Refresh"
                            Width="70"
                            Height="22"
                            Click="ButtonRefreshIncludePorts_Click" />
                </StackPanel>
                <TextBlock Foreground="#FF6666"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Visibility="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IncludeErrorVisible, Converter={StaticResource BoolToVisibility}}"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IncludeErrorMessage}" />
                <TextBlock Text="Inputs (from included graph)" Foreground="#BBBBBB" FontSize="10" />
                <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IncludeInputNames}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#CCCCCC" FontSize="10" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Outputs (from included graph)" Foreground="#BBBBBB" FontSize="10" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IncludeOutputNames}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#CCCCCC" FontSize="10" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <local:InspectorTemplateSelector x:Key="InspectorTemplateSelector"
                                         ConstTemplate="{StaticResource InspectorConstTemplate}"
                                         OpTemplate="{StaticResource InspectorOpTemplate}"
                                         FuncTemplate="{StaticResource InspectorFuncTemplate}"
                                         InputTemplate="{StaticResource InspectorInputTemplate}"
                                         OutputTemplate="{StaticResource InspectorOutputTemplate}"
                                         ParamTemplate="{StaticResource InspectorParamTemplate}"
                                         IncludeTemplate="{StaticResource InspectorIncludeTemplate}" />
        <DrawingBrush x:Key="GraphGridBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#2A2A2A" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="0,20" />
                                <LineGeometry StartPoint="0,0" EndPoint="20,0" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Background="#1B1B1B" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="GraphColumn" Width="*" />
            <ColumnDefinition x:Name="SplitterColumn" Width="6" />
            <ColumnDefinition x:Name="InspectorColumn" Width="320" MinWidth="160" />
        </Grid.ColumnDefinitions>
        <Canvas x:Name="CanvasSurface" ClipToBounds="False" Background="{StaticResource GraphGridBrush}"
                MouseLeftButtonDown="CanvasSurface_MouseLeftButtonDown"
                MouseLeftButtonUp="CanvasSurface_MouseLeftButtonUp"
                MouseMove="CanvasSurface_MouseMove"
                MouseWheel="CanvasSurface_MouseWheel"
                MouseRightButtonDown="CanvasSurface_MouseRightButtonDown"
                MouseRightButtonUp="CanvasSurface_MouseRightButtonUp"
                ContextMenuOpening="CanvasSurface_ContextMenuOpening">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SurfaceScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="SurfaceTranslate" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>
        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#232323"
                      ShowsPreview="True" />
        <Border Grid.Column="2" Background="#2B2B2B" BorderBrush="#3D3D3D" BorderThickness="1,0,0,0">
            <StackPanel Margin="8">
                <DockPanel Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Inspector" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="DirtyIndicator" Text=" •" Foreground="#FFA500" FontSize="12" FontWeight="Bold"
                                   Visibility="Collapsed" ToolTip="Graph has unsaved changes" />
                    </StackPanel>
                    <CheckBox x:Name="CheckLibraryGraph"
                              DockPanel.Dock="Right"
                              Content="Library Graph"
                              Foreground="#CCCCCC"
                              FontSize="10"
                              VerticalAlignment="Center"
                              ToolTip="Library graphs use freeform Input/Output port names instead of signal binding"
                              Checked="CheckLibraryGraph_Changed"
                              Unchecked="CheckLibraryGraph_Changed" />
                </DockPanel>
                <StackPanel x:Name="PanelEvalContext" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock Text="Context:" Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ComboEvalContext"
                              Width="200"
                              Background="#1E1E1E"
                              Foreground="White"
                              BorderBrush="#4A4A4A"
                              BorderThickness="1"
                              SelectionChanged="ComboEvalContext_SelectionChanged" />
                </StackPanel>
                <DockPanel Margin="0,10,0,2">
                    <CheckBox x:Name="CheckDebugLogging"
                              Content="Debug Logging"
                              Foreground="#CCCCCC"
                              FontSize="10"
                              VerticalAlignment="Center"
                              ToolTip="Enable debug logging to trace graph evaluation"
                              Checked="CheckDebugLogging_Changed"
                              Unchecked="CheckDebugLogging_Changed" />
                    <TextBlock x:Name="TextDebugLogPath"
                               DockPanel.Dock="Right"
                               Foreground="#888888"
                               FontSize="9"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Cursor="Hand"
                               MouseLeftButtonDown="TextDebugLogPath_Click"
                               ToolTip="Click to open log file location" />
                </DockPanel>
                <TextBlock Text="Selected Node" Foreground="#BBBBBB" Margin="0,8,0,2" FontSize="10" />
                <TextBlock x:Name="TextNodeTitle" Foreground="White" FontSize="11" Text="(none)" />
                <Expander Header="Edit" IsExpanded="True" Margin="0,8,0,0">
                    <StackPanel Margin="0,4,0,0">
                        <ContentControl x:Name="InspectorContent"
                                        Margin="0,2,0,0"
                                        ContentTemplateSelector="{StaticResource InspectorTemplateSelector}" />
                        <TextBlock x:Name="TextNoSelection"
                                   Foreground="#777777"
                                   FontSize="10"
                                   Margin="0,2,0,0"
                                   Text="Select a node to edit its properties."
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
