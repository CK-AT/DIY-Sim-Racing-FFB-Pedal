<UserControl x:Class="User.PluginSdkDemo.GraphEditor.GraphEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             KeyDown="GraphEditorControl_KeyDown"
             d:DesignHeight="400" d:DesignWidth="600">
    <UserControl.Resources>
        <DrawingBrush x:Key="GraphGridBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#2A2A2A" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="0,20" />
                                <LineGeometry StartPoint="0,0" EndPoint="20,0" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Background="#1B1B1B" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="GraphColumn" Width="*" />
            <ColumnDefinition x:Name="SplitterColumn" Width="6" />
            <ColumnDefinition x:Name="InspectorColumn" Width="320" MinWidth="160" />
        </Grid.ColumnDefinitions>
        <Canvas x:Name="CanvasSurface" ClipToBounds="False" Background="{StaticResource GraphGridBrush}"
                MouseLeftButtonDown="CanvasSurface_MouseLeftButtonDown"
                MouseLeftButtonUp="CanvasSurface_MouseLeftButtonUp"
                MouseMove="CanvasSurface_MouseMove"
                MouseWheel="CanvasSurface_MouseWheel"
                MouseRightButtonDown="CanvasSurface_MouseRightButtonDown"
                MouseRightButtonUp="CanvasSurface_MouseRightButtonUp"
                ContextMenuOpening="CanvasSurface_ContextMenuOpening">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SurfaceScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="SurfaceTranslate" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>
        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#232323"
                      ShowsPreview="True" />
        <Border Grid.Column="2" Background="#2B2B2B" BorderBrush="#3D3D3D" BorderThickness="1,0,0,0">
            <StackPanel Margin="8">
                <TextBlock Text="Inspector" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="Selected Node" Foreground="#BBBBBB" Margin="0,8,0,2" FontSize="10" />
                <TextBlock x:Name="TextNodeTitle" Foreground="White" FontSize="11" Text="(none)" />
                <TextBlock x:Name="TextNodeKind" Foreground="#CCCCCC" FontSize="10" />
                <TextBlock Text="Live Value" Foreground="#BBBBBB" Margin="0,10,0,2" FontSize="10" />
                <TextBlock x:Name="TextNodeValue" Foreground="White" FontSize="11" Text="n/a" />
                <TextBlock x:Name="TextPreviewStatus" Foreground="#FF8A8A" FontSize="10" Margin="0,2,0,0" />
                <TextBlock Text="Info" Foreground="#BBBBBB" Margin="0,10,0,2" FontSize="10" />
                <TextBlock x:Name="TextNodeInfo" Foreground="#CCCCCC" FontSize="10" TextWrapping="Wrap" />
                <DockPanel Margin="0,10,0,2">
                    <TextBlock Text="Preview Inputs" Foreground="#BBBBBB" FontSize="10" />
                    <CheckBox x:Name="CheckLiveInputs"
                              DockPanel.Dock="Right"
                              Content="Live inputs"
                              Foreground="#CCCCCC"
                              FontSize="10"
                              VerticalAlignment="Center"
                              Margin="6,0,0,0"
                              Checked="CheckLiveInputs_Checked"
                              Unchecked="CheckLiveInputs_Unchecked" />
                </DockPanel>
                <ItemsControl x:Name="PreviewInputsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2,0,2">
                                <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" FontSize="10" Width="170" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="2,1,2,1" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Preview Params" Foreground="#BBBBBB" Margin="0,8,0,2" FontSize="10" />
                <ItemsControl x:Name="PreviewParamsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2,0,2">
                                <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" FontSize="10" Width="170" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="2,1,2,1" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="PanelEditFields" Margin="0,10,0,0">
                    <TextBlock Text="Edit" Foreground="#BBBBBB" Margin="0,6,0,2" FontSize="10" />
                    <TextBlock Text="Title" Foreground="#BBBBBB" FontSize="10" />
                    <TextBox x:Name="EditTitle"
                             Margin="0,2,0,6"
                             Background="#1E1E1E"
                             Foreground="White"
                             BorderBrush="#4A4A4A"
                             BorderThickness="1"
                             Padding="3,2,3,2"
                             TextChanged="EditTitle_TextChanged" />
                    <StackPanel x:Name="PanelConst">
                        <TextBlock Text="Const Value" Foreground="#BBBBBB" FontSize="10" />
                        <TextBox x:Name="EditConst"
                                 Margin="0,2,0,6"
                                 Background="#1E1E1E"
                                 Foreground="White"
                                 BorderBrush="#4A4A4A"
                                 BorderThickness="1"
                                 Padding="3,2,3,2"
                                 TextChanged="EditConst_TextChanged" />
                    </StackPanel>
                    <StackPanel x:Name="PanelOp">
                        <TextBlock Text="Operation" Foreground="#BBBBBB" FontSize="10" />
                        <ComboBox x:Name="EditOp"
                                  Margin="0,2,0,6"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  BorderBrush="#4A4A4A"
                                  BorderThickness="1"
                                  SelectionChanged="EditOp_SelectionChanged" />
                    </StackPanel>
                    <StackPanel x:Name="PanelFunc">
                        <TextBlock Text="Function" Foreground="#BBBBBB" FontSize="10" />
                        <ComboBox x:Name="EditFunc"
                                  Margin="0,2,0,6"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  BorderBrush="#4A4A4A"
                                  BorderThickness="1"
                                  SelectionChanged="EditFunc_SelectionChanged" />
                    </StackPanel>
                    <StackPanel x:Name="PanelInclude">
                        <TextBlock Text="Include Path" Foreground="#BBBBBB" FontSize="10" />
                        <DockPanel Margin="0,2,0,6">
                            <Button x:Name="ButtonBrowseInclude"
                                    Content="..."
                                    Width="28"
                                    Height="22"
                                    Margin="0,0,6,0"
                                    Click="ButtonBrowseInclude_Click" />
                            <TextBox x:Name="EditIncludePath"
                                     Background="#1E1E1E"
                                     Foreground="White"
                                     BorderBrush="#4A4A4A"
                                     BorderThickness="1"
                                     Padding="3,2,3,2"
                                     TextChanged="EditIncludePath_TextChanged" />
                        </DockPanel>
                        <Button x:Name="ButtonOpenInclude"
                                Content="Open Include"
                                Margin="0,0,0,6"
                                Height="22"
                                Click="ButtonOpenInclude_Click" />
                        <TextBlock Text="Include Inputs" Foreground="#BBBBBB" FontSize="10" />
                        <StackPanel x:Name="PanelIncludeInputs" Margin="0,2,0,4" />
                        <Button x:Name="ButtonAddIncludeInput"
                                Content="Add Input"
                                Margin="0,0,0,6"
                                Height="22"
                                Click="ButtonAddIncludeInput_Click" />
                        <TextBlock Text="Include Outputs" Foreground="#BBBBBB" FontSize="10" />
                        <StackPanel x:Name="PanelIncludeOutputs" Margin="0,2,0,4" />
                        <Button x:Name="ButtonAddIncludeOutput"
                                Content="Add Output"
                                Margin="0,0,0,6"
                                Height="22"
                                Click="ButtonAddIncludeOutput_Click" />
                    </StackPanel>
                    <StackPanel x:Name="PanelPorts">
                        <TextBlock Text="Ports" Foreground="#BBBBBB" Margin="0,6,0,2" FontSize="10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="ButtonAddInputPort"
                                    Content="+ In"
                                    Width="50"
                                    Margin="0,0,6,0"
                                    Background="#1E1E1E"
                                    Foreground="White"
                                    BorderBrush="#4A4A4A"
                                    BorderThickness="1"
                                    Padding="2,1,2,1"
                                    Click="ButtonAddInputPort_Click" />
                            <Button x:Name="ButtonAddOutputPort"
                                    Content="+ Out"
                                    Width="50"
                                    Background="#1E1E1E"
                                    Foreground="White"
                                    BorderBrush="#4A4A4A"
                                    BorderThickness="1"
                                    Padding="2,1,2,1"
                                    Click="ButtonAddOutputPort_Click" />
                        </StackPanel>
                        <ItemsControl x:Name="PortsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2,0,2">
                                        <TextBlock Text="{Binding KindLabel}" Foreground="#CCCCCC" FontSize="10" Width="54" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="#1E1E1E"
                                                     Foreground="White"
                                                     BorderBrush="#4A4A4A"
                                                     BorderThickness="1"
                                                     Padding="2,1,2,1">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UseSignalOptions}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Grid >
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UseSignalOptions}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="#1E1E1E"
                                                         Foreground="White"
                                                         BorderBrush="#4A4A4A"
                                                         BorderThickness="1"
                                                         Padding="2,1,2,1" />
                                                <Button Grid.Column="1"
                                                        Content="▾"
                                                        Background="#1E1E1E"
                                                        Foreground="White"
                                                        BorderBrush="#4A4A4A"
                                                        BorderThickness="1"
                                                        Padding="0"
                                                        Click="SignalPickerButton_Click" />
                                                <Popup IsOpen="{Binding IsSignalPopupOpen, Mode=TwoWay}"
                                                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                                                       Placement="Bottom"
                                                       StaysOpen="False">
                                                    <Border Background="#1E1E1E" BorderBrush="#4A4A4A" BorderThickness="1">
                                                        <TreeView ItemsSource="{Binding SignalTree}"
                                                                  SelectedItemChanged="SignalTree_SelectedItemChanged"
                                                                  Tag="{Binding}">
                                                            <TreeView.ItemTemplate>
                                                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                                    <TextBlock Text="{Binding Name}" Foreground="White" />
                                                                </HierarchicalDataTemplate>
                                                            </TreeView.ItemTemplate>
                                                        </TreeView>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <Button Content="Settings..."
                                                    Margin="6,0,0,0"
                                                    Height="22"
                                                    Background="#1E1E1E"
                                                    Foreground="White"
                                                    BorderBrush="#4A4A4A"
                                                    BorderThickness="1"
                                                    Padding="4,1,4,1"
                                                    Click="EditParamUi_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowParamFields}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
