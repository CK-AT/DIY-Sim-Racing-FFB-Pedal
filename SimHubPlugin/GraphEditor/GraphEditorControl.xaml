<UserControl x:Class="User.PluginSdkDemo.GraphEditor.GraphEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             KeyDown="GraphEditorControl_KeyDown"
             d:DesignHeight="400" d:DesignWidth="600">
    <UserControl.Resources>
        <DrawingBrush x:Key="GraphGridBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#2A2A2A" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="0,20" />
                                <LineGeometry StartPoint="0,0" EndPoint="20,0" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <Grid Background="#1B1B1B">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <Canvas x:Name="CanvasSurface" Background="{StaticResource GraphGridBrush}"
                MouseLeftButtonDown="CanvasSurface_MouseLeftButtonDown"
                MouseLeftButtonUp="CanvasSurface_MouseLeftButtonUp"
                MouseMove="CanvasSurface_MouseMove"
                MouseWheel="CanvasSurface_MouseWheel"
                MouseRightButtonDown="CanvasSurface_MouseRightButtonDown"
                ContextMenuOpening="CanvasSurface_ContextMenuOpening">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SurfaceScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="SurfaceTranslate" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>
        <Border Grid.Column="1" Background="#2B2B2B" BorderBrush="#3D3D3D" BorderThickness="1,0,0,0">
            <StackPanel Margin="8">
                <TextBlock Text="Inspector" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="Selected Node" Foreground="#BBBBBB" Margin="0,8,0,2" FontSize="10" />
                <TextBlock x:Name="TextNodeTitle" Foreground="White" FontSize="11" Text="(none)" />
                <TextBlock x:Name="TextNodeKind" Foreground="#CCCCCC" FontSize="10" />
                <TextBlock Text="Live Value" Foreground="#BBBBBB" Margin="0,10,0,2" FontSize="10" />
                <TextBlock x:Name="TextNodeValue" Foreground="White" FontSize="11" Text="n/a" />
                <TextBlock x:Name="TextPreviewStatus" Foreground="#FF8A8A" FontSize="10" Margin="0,2,0,0" />
                <TextBlock Text="Info" Foreground="#BBBBBB" Margin="0,10,0,2" FontSize="10" />
                <TextBlock x:Name="TextNodeInfo" Foreground="#CCCCCC" FontSize="10" TextWrapping="Wrap" />
                <TextBlock Text="Preview Inputs" Foreground="#BBBBBB" Margin="0,10,0,2" FontSize="10" />
                <ItemsControl x:Name="PreviewInputsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2,0,2">
                                <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" FontSize="10" Width="110" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="2,1,2,1" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Preview Params" Foreground="#BBBBBB" Margin="0,8,0,2" FontSize="10" />
                <ItemsControl x:Name="PreviewParamsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2,0,2">
                                <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" FontSize="10" Width="110" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         Padding="2,1,2,1" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="PanelEditFields" Margin="0,10,0,0">
                    <TextBlock Text="Edit" Foreground="#BBBBBB" Margin="0,6,0,2" FontSize="10" />
                    <TextBlock Text="Title" Foreground="#BBBBBB" FontSize="10" />
                    <TextBox x:Name="EditTitle"
                             Margin="0,2,0,6"
                             Background="#1E1E1E"
                             Foreground="White"
                             BorderBrush="#4A4A4A"
                             BorderThickness="1"
                             Padding="3,2,3,2"
                             TextChanged="EditTitle_TextChanged" />
                    <StackPanel x:Name="PanelConst">
                        <TextBlock Text="Const Value" Foreground="#BBBBBB" FontSize="10" />
                        <TextBox x:Name="EditConst"
                                 Margin="0,2,0,6"
                                 Background="#1E1E1E"
                                 Foreground="White"
                                 BorderBrush="#4A4A4A"
                                 BorderThickness="1"
                                 Padding="3,2,3,2"
                                 TextChanged="EditConst_TextChanged" />
                    </StackPanel>
                    <StackPanel x:Name="PanelOp">
                        <TextBlock Text="Operation" Foreground="#BBBBBB" FontSize="10" />
                        <ComboBox x:Name="EditOp"
                                  Margin="0,2,0,6"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  BorderBrush="#4A4A4A"
                                  BorderThickness="1"
                                  SelectionChanged="EditOp_SelectionChanged" />
                    </StackPanel>
                    <StackPanel x:Name="PanelFunc">
                        <TextBlock Text="Function" Foreground="#BBBBBB" FontSize="10" />
                        <ComboBox x:Name="EditFunc"
                                  Margin="0,2,0,6"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  BorderBrush="#4A4A4A"
                                  BorderThickness="1"
                                  SelectionChanged="EditFunc_SelectionChanged" />
                    </StackPanel>
                    <StackPanel x:Name="PanelInclude">
                        <TextBlock Text="Include Path" Foreground="#BBBBBB" FontSize="10" />
                        <DockPanel Margin="0,2,0,6">
                            <Button x:Name="ButtonBrowseInclude"
                                    Content="..."
                                    Width="28"
                                    Height="22"
                                    Margin="0,0,6,0"
                                    Click="ButtonBrowseInclude_Click" />
                            <TextBox x:Name="EditIncludePath"
                                     Background="#1E1E1E"
                                     Foreground="White"
                                     BorderBrush="#4A4A4A"
                                     BorderThickness="1"
                                     Padding="3,2,3,2"
                                     TextChanged="EditIncludePath_TextChanged" />
                        </DockPanel>
                        <Button x:Name="ButtonOpenInclude"
                                Content="Open Include"
                                Margin="0,0,0,6"
                                Height="22"
                                Click="ButtonOpenInclude_Click" />
                        <TextBlock Text="Include Inputs" Foreground="#BBBBBB" FontSize="10" />
                        <StackPanel x:Name="PanelIncludeInputs" Margin="0,2,0,4" />
                        <Button x:Name="ButtonAddIncludeInput"
                                Content="Add Input"
                                Margin="0,0,0,6"
                                Height="22"
                                Click="ButtonAddIncludeInput_Click" />
                        <TextBlock Text="Include Outputs" Foreground="#BBBBBB" FontSize="10" />
                        <StackPanel x:Name="PanelIncludeOutputs" Margin="0,2,0,4" />
                        <Button x:Name="ButtonAddIncludeOutput"
                                Content="Add Output"
                                Margin="0,0,0,6"
                                Height="22"
                                Click="ButtonAddIncludeOutput_Click" />
                    </StackPanel>
                    <StackPanel x:Name="PanelParam">
                        <TextBlock Text="Param Default" Foreground="#BBBBBB" FontSize="10" />
                        <TextBox x:Name="EditParamDefault"
                                 Margin="0,2,0,6"
                                 Background="#1E1E1E"
                                 Foreground="White"
                                 BorderBrush="#4A4A4A"
                                 BorderThickness="1"
                                 Padding="3,2,3,2"
                                 TextChanged="EditParamDefault_TextChanged" />
                        <TextBlock Text="Param Min" Foreground="#BBBBBB" FontSize="10" />
                        <TextBox x:Name="EditParamMin"
                                 Margin="0,2,0,6"
                                 Background="#1E1E1E"
                                 Foreground="White"
                                 BorderBrush="#4A4A4A"
                                 BorderThickness="1"
                                 Padding="3,2,3,2"
                                 TextChanged="EditParamMin_TextChanged" />
                        <TextBlock Text="Param Max" Foreground="#BBBBBB" FontSize="10" />
                        <TextBox x:Name="EditParamMax"
                                 Margin="0,2,0,6"
                                 Background="#1E1E1E"
                                 Foreground="White"
                                 BorderBrush="#4A4A4A"
                                 BorderThickness="1"
                                 Padding="3,2,3,2"
                                 TextChanged="EditParamMax_TextChanged" />
                    </StackPanel>
                    <StackPanel x:Name="PanelPorts">
                        <TextBlock Text="Ports" Foreground="#BBBBBB" Margin="0,6,0,2" FontSize="10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="ButtonAddInputPort"
                                    Content="+ In"
                                    Width="50"
                                    Margin="0,0,6,0"
                                    Background="#1E1E1E"
                                    Foreground="White"
                                    BorderBrush="#4A4A4A"
                                    BorderThickness="1"
                                    Padding="2,1,2,1"
                                    Click="ButtonAddInputPort_Click" />
                            <Button x:Name="ButtonAddOutputPort"
                                    Content="+ Out"
                                    Width="50"
                                    Background="#1E1E1E"
                                    Foreground="White"
                                    BorderBrush="#4A4A4A"
                                    BorderThickness="1"
                                    Padding="2,1,2,1"
                                    Click="ButtonAddOutputPort_Click" />
                        </StackPanel>
                        <ItemsControl x:Name="PortsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2,0,2">
                                        <TextBlock Text="{Binding KindLabel}" Foreground="#CCCCCC" FontSize="10" Width="54" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="132"
                                                 Background="#1E1E1E"
                                                 Foreground="White"
                                                 BorderBrush="#4A4A4A"
                                                 BorderThickness="1"
                                                 Padding="2,1,2,1" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
