<Window x:Class="User.PluginSdkDemo.GraphEditor.GraphEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:User.PluginSdkDemo.GraphEditor"
        Title="FFB Graph Editor" Height="700" Width="1100" Background="#1B1B1B">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <!-- Tab item container style -->
        <Style x:Key="GraphEditorTabItem" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#1E1E1E"
                                BorderBrush="#3F3F46"
                                BorderThickness="1,1,1,0"
                                Margin="0,0,2,0"
                                Padding="8,4"
                                CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2D2D30" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#007ACC" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActiveGraph}" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#152A42" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsActiveGraph}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E3A5F" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B7DD8" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab close button style -->
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="×"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#3E3E42" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#2B2B2B" BorderBrush="#3D3D3D" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8">
                <Button x:Name="ButtonNew" Content="New" Width="60" Margin="0,0,8,0" Click="ButtonNew_Click" />
                <Button x:Name="ButtonLoad" Content="Open" Width="60" Margin="0,0,8,0" Click="ButtonLoad_Click" />
                <Button x:Name="ButtonSave" Content="Save" Width="60" Margin="0,0,8,0" Click="ButtonSave_Click" />
                <Button x:Name="ButtonSaveAs" Content="Save As" Width="60" Margin="0,0,8,0" Click="ButtonSaveAs_Click" />
                <Button x:Name="ButtonApply" Content="Apply" Width="60" Margin="0,0,8,0"
                        Click="ButtonApply_Click" ToolTip="Apply changes to runtime evaluation"
                        IsEnabled="False" />
                <Rectangle Width="1" Fill="#3D3D3D" Margin="8,0" />
                <Button x:Name="ButtonCloseTab" Content="Close Tab" Width="70" Click="ButtonCloseTab_Click" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#242424" BorderBrush="#3D3D3D" BorderThickness="0,0,1,0">
                <StackPanel Margin="8">
                    <TextBlock Text="Hierarchy" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" />
                    <TreeView x:Name="TreeHierarchy"
                              Margin="0,8,0,0"
                              Background="#242424"
                              Foreground="White"
                              SelectedItemChanged="TreeHierarchy_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Label}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock Text="Library" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <ListBox x:Name="ListLibrary"
                             Background="#242424"
                             Foreground="White"
                             DisplayMemberPath="Label"
                             MouseDoubleClick="ListLibrary_MouseDoubleClick" />
                    <Button x:Name="ButtonOpenLibrary"
                            Content="Open Selected"
                            Margin="0,6,0,0"
                            Height="22"
                            Click="ButtonOpenLibrary_Click" />
                </StackPanel>
            </Border>

            <!-- Tab Control for multiple graphs -->
            <TabControl x:Name="EditorTabs"
                        Grid.Column="1"
                        Background="#1B1B1B"
                        BorderThickness="0"
                        Padding="0"
                        SelectionChanged="EditorTabs_SelectionChanged">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource GraphEditorTabItem}" />
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Pin icon for active graph -->
                            <TextBlock Text="&#x1F4CC;"
                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
                                       Margin="0,0,4,0"
                                       FontSize="10"
                                       VerticalAlignment="Center" />

                            <!-- Tab label -->
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="#CCCCCC"
                                       VerticalAlignment="Center" />

                            <!-- Dirty indicator -->
                            <TextBlock Text=" *"
                                       Foreground="#FFCC00"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"
                                       VerticalAlignment="Center" />

                            <!-- Close button (hidden for pinned tabs) -->
                            <Button Style="{StaticResource TabCloseButton}"
                                    Visibility="{Binding IsPinned, Converter={StaticResource InverseBoolToVis}}"
                                    Click="TabCloseButton_Click"
                                    Margin="6,0,0,0"
                                    Tag="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding EditorControl}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </Grid>
</Window>
