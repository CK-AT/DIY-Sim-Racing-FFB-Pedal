<Window x:Class="User.PluginSdkDemo.GraphEditor.GraphEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:User.PluginSdkDemo.GraphEditor"
        Title="FFB Graph Editor" Height="700" Width="1100" Background="#1B1B1B">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#2B2B2B" BorderBrush="#3D3D3D" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8">
                <Button x:Name="ButtonLoad" Content="Load" Width="80" Margin="0,0,8,0" Click="ButtonLoad_Click" />
                <Button x:Name="ButtonSave" Content="Save" Width="80" Margin="0,0,8,0" Click="ButtonSave_Click" />
                <Button x:Name="ButtonReset" Content="Reset" Width="80" Click="ButtonReset_Click" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#242424" BorderBrush="#3D3D3D" BorderThickness="0,0,1,0">
                <StackPanel Margin="8">
                    <TextBlock Text="Hierarchy" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" />
                    <TreeView x:Name="TreeHierarchy"
                              Margin="0,8,0,0"
                              Background="#242424"
                              Foreground="White"
                              SelectedItemChanged="TreeHierarchy_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Label}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock Text="Library" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <ListBox x:Name="ListLibrary"
                             Background="#242424"
                             Foreground="White"
                             DisplayMemberPath="Label"
                             MouseDoubleClick="ListLibrary_MouseDoubleClick" />
                    <Button x:Name="ButtonOpenLibrary"
                            Content="Open Selected"
                            Margin="0,6,0,0"
                            Height="22"
                            Click="ButtonOpenLibrary_Click" />
                </StackPanel>
            </Border>
            <local:GraphEditorControl x:Name="GraphEditor" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
