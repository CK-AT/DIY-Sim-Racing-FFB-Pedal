<Window x:Class="User.PluginSdkDemo.GraphEditor.GraphParamUiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Param UI"
        Height="520"
        Width="540"
        WindowStartupLocation="CenterOwner"
        Background="#1B1B1B"
        Foreground="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TextHeader"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#DDDDDD"
                   Margin="0,0,0,8" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Widget" Grid.Row="0" Grid.Column="0" Foreground="#BBBBBB" VerticalAlignment="Center" />
            <ComboBox x:Name="ComboWidget"
                      Grid.Row="0"
                      Grid.Column="1"
                      Background="#1E1E1E"
                      Foreground="White"
                      BorderBrush="#4A4A4A"
                      BorderThickness="1"
                      Margin="0,0,10,6" />

            <TextBlock Text="Label" Grid.Row="0" Grid.Column="2" Foreground="#BBBBBB" VerticalAlignment="Center" />
            <TextBox x:Name="EditLabel"
                     Grid.Row="0"
                     Grid.Column="3"
                     Background="#1E1E1E"
                     Foreground="White"
                     BorderBrush="#4A4A4A"
                     BorderThickness="1"
                     Padding="3,2,3,2"
                     Margin="0,0,0,6" />

            <TextBlock Text="Group" Grid.Row="1" Grid.Column="0" Foreground="#BBBBBB" VerticalAlignment="Center" />
            <TextBox x:Name="EditGroup"
                     Grid.Row="1"
                     Grid.Column="1"
                     Background="#1E1E1E"
                     Foreground="White"
                     BorderBrush="#4A4A4A"
                     BorderThickness="1"
                     Padding="3,2,3,2"
                     Margin="0,0,10,6" />

            <TextBlock Text="Units" Grid.Row="1" Grid.Column="2" Foreground="#BBBBBB" VerticalAlignment="Center" />
            <TextBox x:Name="EditUnits"
                     Grid.Row="1"
                     Grid.Column="3"
                     Background="#1E1E1E"
                     Foreground="White"
                     BorderBrush="#4A4A4A"
                     BorderThickness="1"
                     Padding="3,2,3,2"
                     Margin="0,0,0,6" />

            <TextBlock Text="Step" Grid.Row="2" Grid.Column="0" Foreground="#BBBBBB" VerticalAlignment="Center" />
            <TextBox x:Name="EditStep"
                     Grid.Row="2"
                     Grid.Column="1"
                     Background="#1E1E1E"
                     Foreground="White"
                     BorderBrush="#4A4A4A"
                     BorderThickness="1"
                     Padding="3,2,3,2"
                     Margin="0,0,10,0" />

            <TextBlock Text="Precision" Grid.Row="2" Grid.Column="2" Foreground="#BBBBBB" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                <TextBox x:Name="EditPrecision"
                         Width="80"
                         Background="#1E1E1E"
                         Foreground="White"
                         BorderBrush="#4A4A4A"
                         BorderThickness="1"
                         Padding="3,2,3,2"
                         Margin="0,0,8,0" />
                <CheckBox x:Name="CheckLogScale"
                          Content="Log scale"
                          Foreground="#CCCCCC"
                          VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Default" Grid.Row="3" Grid.Column="0" Foreground="#BBBBBB" VerticalAlignment="Center" />
            <TextBox x:Name="EditDefault"
                     Grid.Row="3"
                     Grid.Column="1"
                     Background="#1E1E1E"
                     Foreground="White"
                     BorderBrush="#4A4A4A"
                     BorderThickness="1"
                     Padding="3,2,3,2"
                     Margin="0,0,10,0" />

            <TextBlock Text="Min" Grid.Row="3" Grid.Column="2" Foreground="#BBBBBB" VerticalAlignment="Center" />
            <TextBox x:Name="EditMin"
                     Grid.Row="3"
                     Grid.Column="3"
                     Background="#1E1E1E"
                     Foreground="White"
                     BorderBrush="#4A4A4A"
                     BorderThickness="1"
                     Padding="3,2,3,2"
                     Margin="0,0,0,0" />

            <TextBlock Text="Max" Grid.Row="4" Grid.Column="0" Foreground="#BBBBBB" VerticalAlignment="Center" />
            <TextBox x:Name="EditMax"
                     Grid.Row="4"
                     Grid.Column="1"
                     Background="#1E1E1E"
                     Foreground="White"
                     BorderBrush="#4A4A4A"
                     BorderThickness="1"
                     Padding="3,2,3,2"
                     Margin="0,6,10,0" />
        </Grid>

        <TextBlock Grid.Row="2" Text="Enum Options" Foreground="#BBBBBB" Margin="0,0,0,4" />
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="GridOptions"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      Background="#1E1E1E"
                      Foreground="White"
                      BorderBrush="#4A4A4A"
                      BorderThickness="1"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      RowHeaderWidth="0"
                      Grid.Row="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="ButtonAddOption"
                        Content="Add"
                        Width="70"
                        Margin="0,0,6,0"
                        Click="ButtonAddOption_Click" />
                <Button x:Name="ButtonRemoveOption"
                        Content="Remove"
                        Width="70"
                        Click="ButtonRemoveOption_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="ButtonCancel_Click" />
            <Button Content="Save" Width="90" Click="ButtonSave_Click" />
        </StackPanel>
    </Grid>
</Window>
