<Window x:Class="User.PluginSdkDemo.GraphEditor.SharedGraphSaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Shared Graph"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#1B1B1B"
        Foreground="White"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Warning header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="!"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#FFCC00"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="This graph is used by multiple vehicles"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#DDDDDD"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Usage details -->
        <Border Grid.Row="1"
                Background="#1E1E1E"
                BorderBrush="#4A4A4A"
                BorderThickness="1"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelUsageDetails">
                    <!-- Direct usage section -->
                    <StackPanel x:Name="PanelDirectUsage">
                        <TextBlock Text="Direct usage:"
                                   FontWeight="SemiBold"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,6"/>
                        <ItemsControl x:Name="ListDirectUsers">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="12,2,0,2">
                                        <TextBlock Text="*" Foreground="#888888" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding}" Foreground="White"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Included by section -->
                    <StackPanel x:Name="PanelIncludedBy" Margin="0,12,0,0">
                        <TextBlock Text="Included by:"
                                   FontWeight="SemiBold"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,6"/>
                        <ItemsControl x:Name="ListIncludedBy">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="12,4,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="*" Foreground="#888888" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding GraphName}" Foreground="#CCCCCC"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Vehicles}" Margin="20,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="->" Foreground="#666666" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding}" Foreground="#88AAFF"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Warning message -->
        <TextBlock Grid.Row="2"
                   Text="Saving will affect ALL listed vehicles."
                   Foreground="#FFCC00"
                   FontWeight="SemiBold"
                   Margin="0,12,0,0"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="ButtonCancel"
                    Content="Cancel"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="OnCancelClick"
                    Background="#3A3A3A"
                    Foreground="White"
                    BorderBrush="#5A5A5A"
                    IsCancel="True"/>
            <Button x:Name="ButtonSaveAsCopy"
                    Content="Save as Copy..."
                    Width="110"
                    Margin="0,0,8,0"
                    Click="OnSaveAsCopyClick"
                    Background="#4A6A4A"
                    Foreground="White"
                    BorderBrush="#5A8A5A"/>
            <Button x:Name="ButtonSaveAnyway"
                    Content="Save Anyway"
                    Width="100"
                    Click="OnSaveAnywayClick"
                    Background="#6A4A4A"
                    Foreground="White"
                    BorderBrush="#8A5A5A"/>
        </StackPanel>
    </Grid>
</Window>
