<Window x:Class="User.PluginSdkDemo.GraphEditor.ParamReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Review"
        Height="500"
        Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#1B1B1B"
        Foreground="White"
        ResizeMode="CanResize"
        MinHeight="350"
        MinWidth="500">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Parameter Review"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#DDDDDD"/>
            <TextBlock x:Name="TextGraphPath"
                       Text="Graph: (loading...)"
                       FontSize="12"
                       Foreground="#888888"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content area -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Active Parameters Section -->
            <Border Grid.Row="0"
                    Background="#1E1E1E"
                    BorderBrush="#4A4A4A"
                    BorderThickness="1"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Active Parameters"
                               FontWeight="SemiBold"
                               Foreground="#AAAAAA"
                               Margin="8,8,8,4"/>

                    <DataGrid Grid.Row="1"
                              x:Name="GridActiveParams"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="White"
                              RowBackground="#1E1E1E"
                              AlternatingRowBackground="#242424"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              IsReadOnly="True">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding ParamName}" Width="*" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Value" Binding="{Binding CurrentValueDisplay}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ValueClamped}" Value="True">
                                                <Setter Property="Foreground" Value="#FFAA55"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Default" Binding="{Binding DefaultDisplay}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DefaultChanged}" Value="True">
                                                <Setter Property="Foreground" Value="#FFCC00"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Range" Binding="{Binding RangeDisplay}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Reset"
                                                Click="OnResetParamClick"
                                                Tag="{Binding ParamName}"
                                                Background="#3A3A3A"
                                                Foreground="White"
                                                BorderBrush="#5A5A5A"
                                                Padding="4,2"
                                                Margin="2"
                                                Visibility="{Binding HasOverride, Converter={StaticResource BoolToVisibility}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2"
                            Content="Reset All to Defaults"
                            Click="OnResetAllClick"
                            HorizontalAlignment="Left"
                            Margin="8"
                            Padding="12,4"
                            Background="#3A3A3A"
                            Foreground="White"
                            BorderBrush="#5A5A5A"/>
                </Grid>
            </Border>

            <!-- Orphaned Overrides Section -->
            <Expander Grid.Row="1"
                      x:Name="ExpanderOrphans"
                      Header="Orphaned Overrides"
                      IsExpanded="False"
                      Foreground="#AAAAAA"
                      Background="#1E1E1E"
                      BorderBrush="#4A4A4A"
                      BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MaxHeight="150"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              x:Name="GridOrphans"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="White"
                              RowBackground="#1E1E1E"
                              AlternatingRowBackground="#242424"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              IsReadOnly="True">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding ParamName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#FF8888"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Stored Value" Binding="{Binding StoredValueDisplay}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete"
                                                Click="OnDeleteOrphanClick"
                                                Tag="{Binding ParamName}"
                                                Background="#4A3A3A"
                                                Foreground="White"
                                                BorderBrush="#6A4A4A"
                                                Padding="4,2"
                                                Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="1"
                            Content="Delete All Orphans"
                            Click="OnDeleteAllOrphansClick"
                            HorizontalAlignment="Left"
                            Margin="8"
                            Padding="12,4"
                            Background="#4A3A3A"
                            Foreground="White"
                            BorderBrush="#6A4A4A"/>
                </Grid>
            </Expander>
        </Grid>

        <!-- Status message -->
        <TextBlock Grid.Row="2"
                   x:Name="TextStatus"
                   Text=""
                   Foreground="#888888"
                   FontStyle="Italic"
                   Margin="0,8,0,0"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="ButtonMarkReviewed"
                    Content="Mark Reviewed"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="OnMarkReviewedClick"
                    Background="#4A6A4A"
                    Foreground="White"
                    BorderBrush="#5A8A5A"
                    Padding="4"/>
            <Button x:Name="ButtonClose"
                    Content="Close"
                    Width="80"
                    Click="OnCloseClick"
                    Background="#3A3A3A"
                    Foreground="White"
                    BorderBrush="#5A5A5A"
                    IsCancel="True"
                    Padding="4"/>
        </StackPanel>
    </Grid>
</Window>
