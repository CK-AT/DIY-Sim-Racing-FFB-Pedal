<Window x:Class="DiyFfb.GraphEditor.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview Inputs"
        Width="320"
        MinWidth="260"
        Background="#2B2B2B"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Preview Inputs" Foreground="#BBBBBB" FontSize="10" />
            <CheckBox x:Name="CheckLiveInputs"
                      DockPanel.Dock="Right"
                      Content="Live inputs"
                      Foreground="#CCCCCC"
                      FontSize="10"
                      VerticalAlignment="Center"
                      Margin="6,0,0,0"
                      Checked="CheckLiveInputs_Changed"
                      Unchecked="CheckLiveInputs_Changed" />
        </DockPanel>
        <TextBlock x:Name="TextPreviewStatus"
                   Grid.Row="1"
                   Foreground="#FF8A8A"
                   FontSize="10"
                   Margin="0,0,0,4" />
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="200">
            <ItemsControl x:Name="PreviewInputsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2,0,2">
                            <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" FontSize="10" Width="170" />
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80"
                                     Background="#1E1E1E"
                                     Foreground="White"
                                     BorderBrush="#4A4A4A"
                                     BorderThickness="1"
                                     Padding="2,1,2,1" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="Preview Params" Foreground="#BBBBBB" Margin="0,8,0,2" FontSize="10" Grid.Row="3" />
        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PreviewParamsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2,0,2">
                            <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" FontSize="10" Width="170" />
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80"
                                     Background="#1E1E1E"
                                     Foreground="White"
                                     BorderBrush="#4A4A4A"
                                     BorderThickness="1"
                                     Padding="2,1,2,1" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
