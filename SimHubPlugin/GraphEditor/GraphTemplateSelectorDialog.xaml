<Window x:Class="User.PluginSdkDemo.GraphEditor.GraphTemplateSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select FFB Graph Template"
        Height="480"
        Width="540"
        WindowStartupLocation="CenterOwner"
        Background="#1B1B1B"
        Foreground="White"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Select FFB Graph Template"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#DDDDDD"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,16">
            <TextBlock Text="No FFB graph is configured for this vehicle."
                       Foreground="#CCCCCC"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Game: " Foreground="#AAAAAA" />
                <TextBlock x:Name="TextGame" Text="" Foreground="#FFFFFF" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Vehicle: " Foreground="#AAAAAA" />
                <TextBlock x:Name="TextVehicle" Text="" Foreground="#FFFFFF" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Select a template to get started:"
                   Foreground="#BBBBBB"
                   Margin="0,0,0,6" />

        <Border Grid.Row="3"
                Background="#1E1E1E"
                BorderBrush="#4A4A4A"
                BorderThickness="1">
            <ListBox x:Name="ListTemplates"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0"
                     SelectionMode="Single"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ListTemplates_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="0,0,0,1"
                                            Padding="10,8,10,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2A2A2A" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#3A3A3A" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="White"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="#AAAAAA"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Category}"
                                       FontSize="10"
                                       Foreground="#888888"
                                       VerticalAlignment="Top"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ButtonSkip"
                    Content="Skip (No Template)"
                    Width="140"
                    Margin="0,0,8,0"
                    Click="ButtonSkip_Click" />
            <Button x:Name="ButtonSelect"
                    Content="Use Selected Template"
                    Width="150"
                    Click="ButtonSelect_Click" />
        </StackPanel>
    </Grid>
</Window>
