<Window x:Class="DiyFfb.OtaSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
        mc:Ignorable="d"
        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" WindowStyle="None" Width="520"
        Background="#FF252525" BorderBrush="Gray" Foreground="White" SizeToContent="WidthAndHeight"
        BorderThickness="1" MouseDown="Window_MouseDown" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid Background="#FF252525">
        <StackPanel Orientation="Vertical" Background="#FF252525">
            <Label Content="Select OTA Targets" FontFamily="Arial Black" HorizontalContentAlignment="Center" />
            <TextBlock x:Name="TextBlock_BindingUrl" Text="Binding URL: -" FontSize="10" Margin="12,0,12,6" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Vertical" Margin="10,6,10,0">
                <Grid Margin="6,0,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Target" FontFamily="Arial Black" FontSize="10"/>
                    <TextBlock Grid.Column="2" Text="Version" FontFamily="Arial Black" FontSize="10"/>
                    <TextBlock Grid.Column="3" Text="Latest Log" FontFamily="Arial Black" FontSize="10"/>
                </Grid>
                <Border BorderThickness="1" BorderBrush="#334E4E4E" CornerRadius="4" Padding="4" Background="#1F252525">
                    <ScrollViewer Height="240">
                        <ItemsControl ItemsSource="{Binding Targets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,2,2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" IsEnabled="{Binding IsOnline}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LatestVersion}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LatestLog}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,10,10,10">
                <styles:SHButtonPrimary x:Name="btn_close" Click="btn_close_Click" Width="120" Height="28" Content="Close" Margin="0,5,5,5"
                                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,0,0,0"/>
                <styles:SHButtonPrimary x:Name="btn_start" Click="btn_start_Click" Width="160" Height="28" Content="Start OTA"
                                        Margin="0,5,5,5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,0,0,0"/>
            </StackPanel>
            <TextBox x:Name="TextBox_Log" Height="90" Margin="12,0,12,12" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="#1F252525" BorderBrush="#4E4E4E" BorderThickness="1"
                     Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
