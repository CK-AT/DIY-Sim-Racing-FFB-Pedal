<Window x:Class="DiyFfb.ProfileBrowser.GraphStorageModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Custom Graph"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner"
        Background="#1B1B1B"
        Foreground="White"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="How should this graph be stored for the vehicle?"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#DDDDDD"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="1">
            <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" Margin="0,0,0,8">
                <Run Text="Reference in place" FontWeight="SemiBold" Foreground="#CCCCCC" />
                <LineBreak />
                <Run Text="Point the vehicle at the file where it is. No duplication, but the profile breaks if you move or delete the file." />
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA">
                <Run Text="Copy into library" FontWeight="SemiBold" Foreground="#CCCCCC" />
                <LineBreak />
                <Run Text="Copy the file into the plugin's graphs/custom folder and point there. Self-contained; edits to the original no longer apply." />
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="ButtonCancel"
                    Content="Cancel"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="OnCancelClick"
                    Background="#3A3A3A"
                    Foreground="White"
                    BorderBrush="#5A5A5A"
                    IsCancel="True"/>
            <Button x:Name="ButtonReference"
                    Content="Reference in Place"
                    Width="130"
                    Margin="0,0,8,0"
                    Click="OnReferenceClick"
                    Background="#4A5A6A"
                    Foreground="White"
                    BorderBrush="#5A7A9A"/>
            <Button x:Name="ButtonCopy"
                    Content="Copy into Library"
                    Width="130"
                    Click="OnCopyClick"
                    Background="#4A6A4A"
                    Foreground="White"
                    BorderBrush="#5A8A5A"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
