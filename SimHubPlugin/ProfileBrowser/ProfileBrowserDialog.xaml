<Window x:Class="DiyFfb.ProfileBrowser.ProfileBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile Browser"
        Height="520"
        Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#1B1B1B"
        Foreground="White"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="TextTitle"
                   Grid.Row="0"
                   Text="Profile Browser"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#DDDDDD"
                   Margin="0,0,0,12" />

        <!-- Tab bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="RadioTemplates"
                         Content="Templates"
                         GroupName="TabGroup"
                         IsChecked="True"
                         Checked="OnTabChanged"
                         Foreground="White"
                         Margin="0,0,16,0"
                         VerticalContentAlignment="Center"/>
            <RadioButton x:Name="RadioMyVehicles"
                         Content="My Vehicles"
                         GroupName="TabGroup"
                         Checked="OnTabChanged"
                         Foreground="White"
                         Margin="0,0,16,0"
                         VerticalContentAlignment="Center"/>
            <Button x:Name="ButtonImport"
                    Content="Import File..."
                    Click="OnImportClick"
                    Padding="8,4"
                    Background="#3A3A3A"
                    Foreground="White"
                    BorderBrush="#5A5A5A"/>
        </StackPanel>

        <!-- List -->
        <Border Grid.Row="2"
                Background="#1E1E1E"
                BorderBrush="#4A4A4A"
                BorderThickness="1">
            <ListBox x:Name="ListItems"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0"
                     SelectionMode="Single"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnItemDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="0,0,0,1"
                                            Padding="10,8,10,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2A2A2A" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#3A3A3A" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="White"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="#AAAAAA"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding GraphName}"
                                       FontSize="11"
                                       Foreground="#888888"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2"
                                       Text="Tuned"
                                       FontSize="11"
                                       Foreground="#88CC88"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasTuning, Converter={StaticResource BoolToVis}}"/>
                            <Button Grid.Column="3"
                                    Content="X"
                                    Click="OnDeleteClick"
                                    Width="22"
                                    Height="22"
                                    FontSize="10"
                                    Background="#4A4A4A"
                                    Foreground="#CCCCCC"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Delete this profile"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Details panel -->
        <Border Grid.Row="3"
                Background="#252525"
                Margin="0,8,0,0"
                Padding="10,8"
                BorderBrush="#3A3A3A"
                BorderThickness="1">
            <StackPanel x:Name="PanelDetails">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Selected: " Foreground="#AAAAAA" />
                    <TextBlock x:Name="TextSelectedName" Text="-" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Graph: " Foreground="#AAAAAA" />
                    <TextBlock x:Name="TextSelectedGraph" Text="-" Foreground="#CCCCCC" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Tuning: " Foreground="#AAAAAA" />
                    <TextBlock x:Name="TextSelectedTuning" Text="-" Foreground="#CCCCCC" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ButtonCancel"
                    Content="Cancel"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="OnCancelClick"
                    Background="#3A3A3A"
                    Foreground="White"
                    BorderBrush="#5A5A5A"/>
            <Button x:Name="ButtonExport"
                    Content="Export..."
                    Width="80"
                    Margin="0,0,8,0"
                    Click="OnExportClick"
                    Background="#3A3A3A"
                    Foreground="White"
                    BorderBrush="#5A5A5A"/>
            <Button x:Name="ButtonUseGraphOnly"
                    Content="Use Graph Only"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="OnUseGraphOnlyClick"
                    Background="#4A6A4A"
                    Foreground="White"
                    BorderBrush="#5A8A5A"/>
            <Button x:Name="ButtonUseGraphTuning"
                    Content="Use Graph + Tuning"
                    Width="130"
                    Click="OnUseGraphTuningClick"
                    Background="#4A7A4A"
                    Foreground="White"
                    BorderBrush="#5A9A5A"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
