<UserControl x:Class="DiyFfb.GeneralKinematicsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DiyFfb"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d"
             d:DesignWidth="540">
    <Grid>
        <Border Background="#7F4E4E4E" CornerRadius="5,5,5,5" BorderThickness="0">
            <StackPanel Width="540">
                <Label Content="KINEMATICS" Width="300" Foreground="White" FontFamily="Arial Black" Height="20" Padding="0,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,5,0,0"/>
                <Canvas x:Name="canvas_kinematic" Height="340" Width="417" Background="#7F20232F" ClipToBounds="True" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70,0,0,0" />
                <StackPanel Orientation="Horizontal" Width="540" Margin="0,4,0,0">
                    <Label Content="Rail - (mm):" Height="20" Width="80" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" Margin="70,0,0,0"/>
                    <TextBox x:Name="TextRailNegative" TextChanged="RailTravel_TextChanged" LostFocus="RailTravel_LostFocus" PreviewMouseWheel="RailTravel_MouseWheel" Height="20" Width="60" Padding="0,0,0,0" FontFamily="Arial" FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#00252525" Foreground="White" BorderThickness="0,0,0,0"/>
                    <Label Content="Rail + (mm):" Height="20" Width="80" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" Margin="10,0,0,0"/>
                    <TextBox x:Name="TextRailPositive" TextChanged="RailTravel_TextChanged" LostFocus="RailTravel_LostFocus" PreviewMouseWheel="RailTravel_MouseWheel" Height="20" Width="60" Padding="0,0,0,0" FontFamily="Arial" FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#00252525" Foreground="White" BorderThickness="0,0,0,0"/>
                    <styles:SHButtonPrimary x:Name="btn_rebuild" Click="btn_rebuild_Click" Width="60" Content="Fit" Height="20" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" MinHeight="20" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Width="540" Margin="0,2,0,0">
                    <Label Content="Pose mode:" Height="20" Width="80" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" Margin="70,0,0,0"/>
                    <ComboBox x:Name="PoseModeCombo" SelectionChanged="PoseModeCombo_SelectionChanged" Width="120" Height="20" FontSize="10" SelectedIndex="0" Margin="3,0,0,0" HorizontalAlignment="Left" BorderThickness="0,0,0,0">
                        <ComboBoxItem Content="Live" />
                        <ComboBoxItem Content="Test" />
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="TestPosePanel" Orientation="Horizontal" Width="540" Margin="0,2,0,0" Visibility="Collapsed">
                    <Label Content="Test pos (mm):" Height="20" Width="80" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" Margin="70,0,0,0"/>
                    <TextBox x:Name="TextTestPosition" TextChanged="TestPose_TextChanged" LostFocus="TestPose_LostFocus" PreviewMouseWheel="TestPose_MouseWheel" Height="20" Width="60" Padding="0,0,0,0" FontFamily="Arial" FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#00252525" Foreground="White" BorderThickness="0,0,0,0"/>
                    <Label Content="Test force (N):" Height="20" Width="85" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" Margin="10,0,0,0"/>
                    <TextBox x:Name="TextTestForce" TextChanged="TestPose_TextChanged" LostFocus="TestPose_LostFocus" PreviewMouseWheel="TestPose_MouseWheel" Height="20" Width="60" Padding="0,0,0,0" FontFamily="Arial" FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#00252525" Foreground="White" BorderThickness="0,0,0,0"/>
                </StackPanel>
                <Label x:Name="Label_status" Content="" Height="15" Width="400" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="9" Foreground="White" HorizontalAlignment="Left" Margin="70,2,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="70,6,0,0">
                    <Label Content="Pins" Height="15" Width="40" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial Black" FontSize="10"/>
                    <Label Content="Polar ref:" Height="15" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" Margin="20,0,0,0"/>
                    <ComboBox x:Name="PolarRefCombo" SelectionChanged="PolarRefCombo_SelectionChanged" Width="60" Height="20" FontSize="10" Margin="3,0,0,0" VerticalContentAlignment="Center" BorderThickness="0,0,0,0"
                              ToolTip="Pin that the Dist/Angle columns are measured relative to (angle in degrees from +X, CCW)."/>
                </StackPanel>
                <DataGrid x:Name="PinGrid" Width="450" Height="120" Margin="15,0,0,0" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal" Background="#00252525" Foreground="White" PreviewMouseWheel="PinGrid_PreviewMouseWheel">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#334E4E4E"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontFamily" Value="Arial"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Padding" Value="2"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding PinId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="40"/>
                        <DataGridTextColumn Header="X" Binding="{Binding X, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="60"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="60"/>
                        <DataGridTextColumn Header="Dist" Binding="{Binding Distance, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="58"/>
                        <DataGridTextColumn Header="Angle" Binding="{Binding Angle, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="58"/>
                        <DataGridCheckBoxColumn Header="Ground" Binding="{Binding Grounded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridCheckBoxColumn Header="Contact" Binding="{Binding IsContactPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridCheckBoxColumn Header="Rail" Binding="{Binding IsRailInterface, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Width="400" Margin="70,2,0,0" HorizontalAlignment="Left">
                    <styles:SHButtonPrimary x:Name="btn_add_pin" Click="btn_add_pin_Click" Width="60" Content="Add pin" Height="20" Margin="0,0,4,0" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" MinHeight="20" />
                    <styles:SHButtonPrimary x:Name="btn_remove_pin" Click="btn_remove_pin_Click" Width="70" Content="Remove pin" Height="20" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" MinHeight="20" />
                </StackPanel>
                <Label Content="Bars" Height="15" Width="100" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial Black" FontSize="10" HorizontalAlignment="Left" Margin="70,6,0,0"/>
                <DataGrid x:Name="BarGrid" Width="400" Height="98" Margin="15,0,0,0" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal" Background="#00252525" Foreground="White">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#334E4E4E"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontFamily" Value="Arial"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Padding" Value="2"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pins" Binding="{Binding PinSummary}" IsReadOnly="True" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding BarBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Pick" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Pick" Width="45" Height="18" Padding="0,0,0,0" Click="OnPickPinsClicked"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="Metering" Binding="{Binding IsMetering, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Width="400" Margin="70,2,0,10" HorizontalAlignment="Left">
                    <styles:SHButtonPrimary x:Name="btn_add_bar" Click="btn_add_bar_Click" Width="60" Content="Add bar" Height="20" Margin="0,0,4,0" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" MinHeight="20" />
                    <styles:SHButtonPrimary x:Name="btn_remove_bar" Click="btn_remove_bar_Click" Width="70" Content="Remove bar" Height="20" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" MinHeight="20" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
