<UserControl x:Class="User.PluginSdkDemo.FlightStickConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:User.PluginSdkDemo"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins" mc:Ignorable="d" 
             xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins" 
             xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             >
    <Grid>
        <StackPanel Orientation="Vertical" Grid.RowSpan="3">
            <Border Background="#7F4E4E4E" CornerRadius="5,5,5,5" BorderThickness="0,0,0,0" >
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="540">
                    <Label Content="Axis Assignments" Width="150" Padding="0,5,0,10" VerticalContentAlignment="Center" FontFamily="Arial Black" HorizontalAlignment="Left" Margin="70,0,0,0"/>
                    <StackPanel Width="540" Orientation="Vertical">
                        <StackPanel Width="400" Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Foreground="White" FontSize="10" FontFamily="Arial" Content="Stick Axis:" VerticalAlignment="Center" Width="150" HorizontalAlignment="Right"/>
                            <local:AxisSelector x:Name="uc_axis_selector_stick" AxisIDChanged="OnAxisIDChanged"/>
                        </StackPanel>
                        <StackPanel Width="400" Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Foreground="White" FontSize="10" FontFamily="Arial" Content="Controller Output Axis:" VerticalAlignment="Center" Width="150" HorizontalAlignment="Right"/>
                            <local:ControllerAxisSelector x:Name="uc_controller_axis_stick" ControllerAxisChanged="uc_controller_axis_stick_ControllerAxisChanged"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="#7F4E4E4E" CornerRadius="5,5,5,5" BorderThickness="0,3,0,0" >
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="540">
                    <Label Content="Motion Range" Width="150" Padding="0,5,0,10" VerticalContentAlignment="Center" FontFamily="Arial Black" HorizontalAlignment="Left" Margin="70,0,0,0"/>
                    <StackPanel Width="540" Orientation="Vertical">
                        <StackPanel Width="400" Orientation="Horizontal" Margin="0,0,0,0">
                            <Label x:Name="Label_min_pos" Width="37" Height="30" Foreground="White" RenderTransformOrigin="0.5,0.5" Canvas.Top="3" FontSize="10" FontFamily="Arial" Canvas.Left="5" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Min" Padding="0,0,0,0" HorizontalContentAlignment="Center"/>
                            <Grid Width="326" Height="20">
                                <controls:RangeSlider x:Name="Rangeslider_travel_range" Style="{DynamicResource RangeSliderStyle}" MinRangeWidth="1" Grid.Column="2" Height="20" LowerValueChanged="Rangeslider_travel_range_LowerValueChanged" UpperValueChanged="Rangeslider_travel_range_UpperValueChanged" MinRange="1" SmallChange="1" IsSnapToTickEnabled="True" UpperValue="30" VerticalAlignment="Top" LowerValue="5" Minimum="-100" Maximum="100" Width="326" SizeChanged="Rangeslider_travel_range_SizeChanged"/>
                                <Canvas x:Name="Canvas_travel_markers" Width="326" Height="20" IsHitTestVisible="False">
                                    <Path x:Name="Rect_axis_position" Width="10" Height="8" Fill="#FF5BD65B" Stroke="#FF5BD65B" StrokeThickness="1" StrokeLineJoin="Round" Stretch="Fill" Canvas.Top="-2"
                                          Data="M 0,0 L 1,0 L 0.5,1 Z"/>
                                    <Path x:Name="Rect_trim_center" Width="8" Height="8" Fill="#FFF0B84A" Stroke="#FFF0B84A" StrokeThickness="1" StrokeLineJoin="Round" Stretch="Fill" Canvas.Top="15"
                                          Data="M 0.5,0 L 1,0.5 L 0.5,1 L 0,0.5 Z"/>
                                </Canvas>
                            </Grid>
                            <Label x:Name="Label_max_pos" Width="37" Height="30" Foreground="White" RenderTransformOrigin="0.5,0.5" Canvas.Top="3" FontSize="10" FontFamily="Arial" Canvas.Left="5" HorizontalAlignment="Right" VerticalAlignment="Top" Content="Max" Padding="0,0,0,0" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="#7F4E4E4E" CornerRadius="5,5,5,5" BorderThickness="0,3,0,0" >
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="540">
                    <Label Content="Additional Settings" Width="150" Padding="0,5,0,10" VerticalContentAlignment="Center" FontFamily="Arial Black" HorizontalAlignment="Left" Margin="70,0,0,0"/>
                    <StackPanel Width="540" Orientation="Vertical">
                        <StackPanel Width="400" Height="40">
                            <Label x:Name="label_damping"  Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Damping:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_damping" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.005" Maximum="10" IsSnapToTickEnabled="True" Value="0.5" SmallChange="0.001" TickFrequency="0.001" ValueChanged="OnDampingChanged"/>
                        </StackPanel>
                        <StackPanel Width="400" Height="40">
                            <Label x:Name="label_centering_spring_const" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Centering Spring Constant:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_centering_spring_const" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="10" IsSnapToTickEnabled="True" Value="1.5" SmallChange="0.1" TickFrequency="0.1" ValueChanged="OnCentringSpringChanged"/>
                        </StackPanel>
                        <StackPanel Width="400" Height="40">
                            <Label x:Name="label_friction"  Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Friction:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_friction" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="100" IsSnapToTickEnabled="True" Value="2.0" SmallChange="0.1"  TickFrequency="0.1" ValueChanged="OnFrictionChanged"/>
                        </StackPanel>
                        <StackPanel Width="400" Height="40">
                            <Label x:Name="label_simulated_mass"  Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Simulated Mass:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_simulated_mass" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.05" Maximum="10" IsSnapToTickEnabled="True" Value="0.1" SmallChange="0.01"  TickFrequency="0.01" ValueChanged="OnSimulatedMassChanged"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="#7F4E4E4E" CornerRadius="5,5,5,5" BorderThickness="0,3,0,0" >
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="540">
                    <Label Content="X-Plane FFB" Width="150" Padding="0,5,0,10" VerticalContentAlignment="Center" FontFamily="Arial Black" HorizontalAlignment="Left" Margin="70,0,0,0"/>
                    <StackPanel Width="540" Orientation="Vertical">
                        <StackPanel Width="400" Height="30" Orientation="Horizontal">
                            <styles:SHToggleButton x:Name="Toggle_xplane_ffb_enabled" Content="" Checked="Toggle_xplane_ffb_enabled_Checked" Unchecked="Toggle_xplane_ffb_enabled_Unchecked" IsChecked="True" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial" ToolTip="Enable X-Plane FFB for this function" RenderTransformOrigin="0.5,0.5" Margin="-10,0,0,0" />
                            <Label x:Name="label_xplane_ffb_enabled" Content="Enable FFB" Height="20" Width="130" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" HorizontalAlignment="Left" FontSize="10" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_kq" Width="400" Height="40">
                            <Label x:Name="label_xplane_kq" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Spring Gain @ Vref:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_kq" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="2.0" IsSnapToTickEnabled="True" Value="1.0" SmallChange="0.001" TickFrequency="0.001" ValueChanged="OnXPlaneKqChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_kcenter" Width="400" Height="40">
                            <Label x:Name="label_xplane_kcenter" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Center Gain:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_kcenter" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="5.0" IsSnapToTickEnabled="True" Value="1.0" SmallChange="0.01" TickFrequency="0.01" ValueChanged="OnXPlaneKcenterChanged"/>
                        </StackPanel>
                        <StackPanel Width="400" Height="40">
                            <Label x:Name="label_xplane_krate" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Damper Gain @ Vref:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_krate" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="2.0" IsSnapToTickEnabled="True" Value="1.0" SmallChange="0.001" TickFrequency="0.001" ValueChanged="OnXPlaneKrateChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_rpm_blend" Width="400" Height="40">
                            <Label x:Name="label_xplane_rpm_blend" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="RPM Blend:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_rpm_blend" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="1.0" IsSnapToTickEnabled="True" Value="0.5" SmallChange="0.01" TickFrequency="0.01" ValueChanged="OnXPlaneRpmBlendChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_friction_q" Width="400" Height="40">
                            <Label x:Name="label_xplane_friction_q" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Friction Gain @ Vref:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_friction_q" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="5.0" IsSnapToTickEnabled="True" Value="0.0" SmallChange="0.01" TickFrequency="0.01" ValueChanged="OnXPlaneFrictionQChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_friction_torque" Width="400" Height="40">
                            <Label x:Name="label_xplane_friction_torque" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Friction Gain @ Torque:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_friction_torque" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="20.0" IsSnapToTickEnabled="True" Value="0.0" SmallChange="0.1" TickFrequency="0.1" ValueChanged="OnXPlaneFrictionTorqueChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_friction_low_rpm" Width="400" Height="40">
                            <Label x:Name="label_xplane_friction_low_rpm" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Low RPM Friction Gain:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_friction_low_rpm" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="20.0" IsSnapToTickEnabled="True" Value="0.0" SmallChange="0.1" TickFrequency="0.1" ValueChanged="OnXPlaneFrictionLowRpmChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_load_torque_gain" Width="400" Height="40">
                            <Label x:Name="label_xplane_load_torque_gain" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Load Gain @ Torque:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_load_torque_gain" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="5.0" IsSnapToTickEnabled="True" Value="1.0" SmallChange="0.01" TickFrequency="0.01" ValueChanged="OnXPlaneLoadTorqueGainChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_load_force_clamp" Width="400" Height="40">
                            <Label x:Name="label_xplane_load_force_clamp" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Load Force Clamp:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_load_force_clamp" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="5000.0" IsSnapToTickEnabled="True" Value="1000.0" SmallChange="10.0" TickFrequency="10.0" ValueChanged="OnXPlaneLoadForceClampChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_aero_moment_gain" Width="400" Height="40">
                            <Label x:Name="label_xplane_aero_moment_gain" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Aero Moment Gain:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_aero_moment_gain" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="-0.1" Maximum="0.1" IsSnapToTickEnabled="True" Value="0.0" SmallChange="0.001" TickFrequency="0.001" ValueChanged="OnXPlaneAeroMomentGainChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_auto_tune" Width="400" Height="30" Orientation="Horizontal">
                            <styles:SHToggleButton x:Name="Toggle_xplane_auto_tune" Content="" Checked="Toggle_xplane_auto_tune_Checked" Unchecked="Toggle_xplane_auto_tune_Unchecked" IsChecked="False" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial" ToolTip="Auto-tune the aero moment gain during a reference flight" RenderTransformOrigin="0.5,0.5" Margin="-10,0,0,0" />
                            <Label x:Name="label_xplane_auto_tune" Content="Auto-tune load gain (reference flight)" Height="20" Width="300" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" HorizontalAlignment="Left" FontSize="10" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Width="400" Height="40">
                            <Label x:Name="label_xplane_trim_mm_per_deg" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Trim Scale:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_trim_mm_per_deg" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="50.0" IsSnapToTickEnabled="True" Value="0.1" SmallChange="0.01" TickFrequency="0.01" ValueChanged="OnXPlaneTrimScaleChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_buffet_start" Width="400" Height="40">
                            <Label x:Name="label_xplane_buffet_start_deg" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Buffet Start (deg):" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_buffet_start_deg" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="30.0" IsSnapToTickEnabled="True" Value="10" SmallChange="0.5" TickFrequency="0.5" ValueChanged="OnXPlaneBuffetStartChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_buffet_full" Width="400" Height="40">
                            <Label x:Name="label_xplane_buffet_full_deg" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Buffet Full (deg):" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_buffet_full_deg" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="30.0" IsSnapToTickEnabled="True" Value="18" SmallChange="0.5" TickFrequency="0.5" ValueChanged="OnXPlaneBuffetFullChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_buffet_gain" Width="400" Height="40">
                            <Label x:Name="label_xplane_buffet_gain" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Buffet Gain @ Vref:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_buffet_gain" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="200.0" IsSnapToTickEnabled="True" Value="0.05" SmallChange="0.001" TickFrequency="0.001" ValueChanged="OnXPlaneBuffetGainChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="Panel_xplane_weathervane_gain" Width="400" Height="40">
                            <Label x:Name="label_xplane_weathervane_gain" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Weather-Vaning Gain:" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_weathervane_gain" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="0.0" Maximum="2.0" IsSnapToTickEnabled="True" Value="0.0" SmallChange="0.001" TickFrequency="0.001" ValueChanged="OnXPlaneWeathervaneGainChanged"/>
                        </StackPanel>
                        <StackPanel Width="400" Height="40">
                            <Label x:Name="label_xplane_vref" Foreground="White" FontSize="10" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Vref (kts):" Padding="0,0,0,8"/>
                            <Slider x:Name="Slider_xplane_vref" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" Width="400" Height="10" Minimum="10" Maximum="200" IsSnapToTickEnabled="True" Value="60" SmallChange="1" TickFrequency="1" ValueChanged="OnXPlaneVrefChanged"/>
                        </StackPanel>
                        <StackPanel Width="400" Margin="0,6,0,10">
                            <Grid Width="400" Height="134" Background="#00252525">
                                <Canvas x:Name="Canvas_xplane_gain" Width="400" Height="120">
                                    <Polyline x:Name="Polyline_xplane_spring" Stroke="#FF6BD26B" StrokeThickness="1.5"/>
                                    <Polyline x:Name="Polyline_xplane_damper" Stroke="#FF4AA3FF" StrokeThickness="1.5"/>
                                    <Line x:Name="Line_xplane_cursor" Stroke="#FFFFD166" StrokeThickness="1" X1="0" X2="0" Y1="0" Y2="120"/>
                                </Canvas>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,2">
                                        <Rectangle Width="10" Height="2" Fill="#FF6BD26B" VerticalAlignment="Center"/>
                                        <TextBlock Foreground="White" FontSize="10" Text="Spring" Margin="6,0,11,0"/>
                                        <TextBlock x:Name="TextBlock_xplane_spring_value" Foreground="White" FontSize="10" Text="--"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Rectangle Width="10" Height="2" Fill="#FF4AA3FF" VerticalAlignment="Center"/>
                                        <TextBlock Foreground="White" FontSize="10" Text="Damper" Margin="6,0,4,0"/>
                                        <TextBlock x:Name="TextBlock_xplane_damper_value" Foreground="White" FontSize="10" Text="--"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Center">
                                <StackPanel Width="70">
                                    <TextBlock x:Name="TextBlock_xplane_ias" Foreground="White" FontSize="10" Text="IAS: -- kt" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Width="70">
                                    <TextBlock x:Name="TextBlock_xplane_alpha" Foreground="White" FontSize="10" Text="Alpha: -- deg" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Width="70">
                                    <TextBlock x:Name="TextBlock_xplane_beta" Foreground="White" FontSize="10" Text="Beta: -- deg" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Width="70">
                                    <TextBlock x:Name="TextBlock_xplane_trim" Foreground="White" FontSize="10" Text="Trim: -- mm" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Width="70">
                                    <TextBlock x:Name="TextBlock_xplane_vane" Foreground="White" FontSize="10" Text="Vane: -- mm" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <UniformGrid Columns="3" Rows="5" Margin="0,6,0,0">
                                <TextBlock x:Name="TextBlock_xplane_tas" Foreground="White" FontSize="9" Text="TAS: -- m/s" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_qhat" Foreground="White" FontSize="9" Text="qHat: --" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_g" Foreground="White" FontSize="9" Text="G: --" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_on_ground" Foreground="White" FontSize="9" Text="Ground: --" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_qscale" Foreground="White" FontSize="9" Text="Scale: --" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_buffet" Foreground="White" FontSize="9" Text="Buffet: --" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_rotor" Foreground="White" FontSize="9" Text="Rotor: --" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_torque" Foreground="White" FontSize="9" Text="Torque: -- Nm" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_omega" Foreground="White" FontSize="9" Text="Omega: -- RPM" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_prop" Foreground="White" FontSize="9" Text="Prop: --" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_nominal_rpm" Foreground="White" FontSize="9" Text="Nominal: -- RPM" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_omega_scale" Foreground="White" FontSize="9" Text="Omega scale: --" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_gscale" Foreground="White" FontSize="9" Text="G scale: --" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_load" Foreground="White" FontSize="9" Text="Load: --" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlock_xplane_trim_deg" Foreground="White" FontSize="9" Text="Trim: -- deg" HorizontalAlignment="Center"/>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
