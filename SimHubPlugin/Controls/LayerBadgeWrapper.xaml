<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DiyFfb.Controls">

    <!-- Default style for LayerBadgeWrapper -->
    <Style TargetType="{x:Type local:LayerBadgeWrapper}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:LayerBadgeWrapper}">
                    <Grid>
                        <!-- Content (the wrapped control) -->
                        <ContentPresenter />

                        <!-- Badge overlay: positioned at top-right, shifted up via RenderTransform
                             to avoid layout clipping while staying above the slider -->
                        <Border x:Name="PART_Badge"
                                HorizontalAlignment="{TemplateBinding BadgeHorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding BadgeVerticalAlignment}"
                                CornerRadius="2"
                                Padding="4,1"
                                Margin="{TemplateBinding BadgeMargin}"
                                Background="Transparent"
                                Visibility="Hidden"
                                ToolTipService.ShowDuration="30000"
                                ToolTipService.InitialShowDelay="300">
                            <Border.RenderTransform>
                                <TranslateTransform
                                    X="{Binding BadgeOffsetX, RelativeSource={RelativeSource TemplatedParent}}"
                                    Y="{Binding BadgeOffsetY, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border.RenderTransform>
                            <TextBlock x:Name="PART_BadgeText"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="[?]" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
