<Window x:Class="DiyFfb.Controls.OverrideReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Override Review"
        Height="450"
        Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#1B1B1B"
        Foreground="White"
        ResizeMode="CanResize"
        MinHeight="300"
        MinWidth="500">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Active Overrides"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#DDDDDD"
                   Margin="0,0,0,12"/>

        <!-- DataGrid -->
        <Border Grid.Row="1"
                Background="#1E1E1E"
                BorderBrush="#4A4A4A"
                BorderThickness="1">
            <Grid>
                <DataGrid x:Name="GridOverrides"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White"
                          RowBackground="#1E1E1E"
                          AlternatingRowBackground="#242424"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          IsReadOnly="True">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2A2A2A"/>
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="BorderBrush" Value="#3A3A3A"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Function" Binding="{Binding FunctionName}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Field" Binding="{Binding FieldDisplayName}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Value" Binding="{Binding ValueDisplay}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Layer" Binding="{Binding LayerDisplay}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentLayer}" Value="User">
                                            <Setter Property="Foreground" Value="#64B5F6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentLayer}" Value="Profile">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Button Content="Move"
                                                Click="OnMoveClick"
                                                Background="#3A3A3A"
                                                Foreground="White"
                                                BorderBrush="#5A5A5A"
                                                Padding="6,2"
                                                Margin="2,0"
                                                ToolTip="{Binding MoveTooltip}"
                                                Visibility="{Binding CanMove, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Bake"
                                                Click="OnBakeClick"
                                                Background="#3A4A3A"
                                                Foreground="White"
                                                BorderBrush="#4A6A4A"
                                                Padding="6,2"
                                                Margin="2,0"
                                                ToolTip="Save effective value to baseline and clear override"/>
                                        <Button Content="Clear"
                                                Click="OnClearClick"
                                                Background="#4A3A3A"
                                                Foreground="White"
                                                BorderBrush="#6A4A4A"
                                                Padding="6,2"
                                                Margin="2,0"
                                                ToolTip="Remove this override"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <TextBlock x:Name="TextNoOverrides"
                           Text="No overrides are active."
                           Foreground="#888888"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="2"
                   x:Name="TextStatus"
                   Text=""
                   Foreground="#888888"
                   FontStyle="Italic"
                   Margin="0,8,0,0"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
            <Button x:Name="ButtonClearAllUser"
                    Content="Clear All User"
                    Click="OnClearAllUserClick"
                    Background="#4A3A3A"
                    Foreground="White"
                    BorderBrush="#6A4A4A"
                    Padding="8,4"
                    Margin="0,0,8,0"/>
            <Button x:Name="ButtonClearAllProfile"
                    Content="Clear All Profile"
                    Click="OnClearAllProfileClick"
                    Background="#4A3A3A"
                    Foreground="White"
                    BorderBrush="#6A4A4A"
                    Padding="8,4"
                    Margin="0,0,8,0"/>

            <!-- Spacer -->
            <Border Width="1" />

            <Button Content="Close"
                    Click="OnCloseClick"
                    HorizontalAlignment="Right"
                    Background="#3A3A3A"
                    Foreground="White"
                    BorderBrush="#5A5A5A"
                    Padding="12,4"
                    IsCancel="True"
                    Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
